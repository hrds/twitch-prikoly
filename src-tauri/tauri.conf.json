{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwitchPrikoly",
  "version": "0.1.0",
  "identifier": "com.hrd.tp",
  "build": {
    "beforeDevCommand": "bun run --cwd src-backend build:sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd src-backend build:sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TwitchPrikoly",
        "width": 420,
        "height": 700,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/twitch-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
